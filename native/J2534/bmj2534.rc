#include <windows.h>
#include "bmj2534_version.h"
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
1 VERSIONINFO
FILEVERSION BMJ_FILEVERSION
PRODUCTVERSION BMJ_FILEVERSION
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "BUSMUST Co., Ltd.\0"
            VALUE "FileDescription", "BUSMUST J2534 PassThru adapter\0"
            VALUE "FileVersion", BMJ_FILEVERSION_STRING
            VALUE "ProductName", "BUSMUST BMAPI J2534 adapter\0"
            VALUE "ProductVersion", BMJ_FILEVERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
