1 VERSIONINFO
FILEVERSION BMJ_FILEVERSION
PRODUCTVERSION BMJ_FILEVERSION
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName","BUSMUST"
            VALUE "FileDescription","BUSMUST J2534 Device Configuration"
            VALUE "FileVersion",BMJ_FILEVERSION_STRING
            VALUE "ProductName","BUSMUST J2534"
            VALUE "ProductVersion",BMJ_FILEVERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation",0x409,1200
    END
END
